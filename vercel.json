{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "rewrites": [
    { "source": "/api/categories", "destination": "/api/meta?type=categories" },
    { "source": "/api/conditions", "destination": "/api/meta?type=conditions" },
    { "source": "/api/config", "destination": "/api/meta?type=config" },
    { "source": "/api/auth/login", "destination": "/api/auth?action=login" },
    { "source": "/api/auth/me", "destination": "/api/auth?action=me" },
    { "source": "/api/admin/products/:id", "destination": "/api/admin-products?id=:id" },
    { "source": "/api/admin/products", "destination": "/api/admin-products" },
    { "source": "/api/admin/users/:id", "destination": "/api/admin-users?id=:id" },
    { "source": "/api/admin/users", "destination": "/api/admin-users" },
    { "source": "/api/products/:id", "destination": "/api/products?id=:id" },
    { "source": "/catalogo", "destination": "/frontend/pages/catalogo.html" },
    { "source": "/vender", "destination": "/frontend/pages/vender.html" },
    { "source": "/nosotros", "destination": "/frontend/pages/nosotros.html" },
    { "source": "/admin/login", "destination": "/frontend/admin/login.html" },
    { "source": "/admin", "destination": "/frontend/admin/index.html" },
    { "source": "/admin/catalogo", "destination": "/frontend/admin/catalogo.html" },
    { "source": "/admin/productos/nuevo", "destination": "/frontend/admin/producto-nuevo.html" },
    { "source": "/admin/productos/:path", "destination": "/frontend/admin/producto-editar.html" },
    { "source": "/admin/usuarios/nuevo", "destination": "/frontend/admin/usuario-nuevo.html" },
    { "source": "/admin/usuarios/:path", "destination": "/frontend/admin/usuario-editar.html" },
    { "source": "/admin/categorias", "destination": "/frontend/admin/categorias.html" },
    { "source": "/admin/usuarios", "destination": "/frontend/admin/usuarios.html" },
    { "source": "/((?!api|frontend|Referencia|node_modules).*)", "destination": "/frontend/pages/inicio.html" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET,POST,PUT,DELETE,OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, Authorization" }
      ]
    }
  ]
}